# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local-only dependency overrides (pub's own convention: never commit these,
# each developer's overrides are their own). pubspec.lock is intentionally
# NOT listed here — this is an app, not a package, so the lockfile is
# committed to pin exact dependency versions across machines and CI.
pubspec_overrides.yaml

# Local golden-test failure diffs, written next to the golden files being
# compared when `flutter test --tags golden` fails without --update-goldens.
**/failures/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Downloaded chromedriver binaries (used for flutter drive integration tests)
/chromedriver/

# Environment variables and credentials. This project has none today, but a
# generated .env or key file should never land in a boilerplate other
# projects clone from.
.env
.env.*
*.pem
*.key
